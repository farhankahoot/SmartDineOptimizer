# Copy to .env and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------- database
# SQLite for local development:
DATABASE_URL="file:./dev.db"
# MySQL for production — also set provider = "mysql" in prisma/schema.prisma:
# DATABASE_URL="mysql://user:password@host:3306/smartdine"

# ------------------------------------------------------------------ secret
# Generate with: npm run gen:secret
# The server refuses to start in production if this is short or a placeholder.
JWT_SECRET=""

# ------------------------------------------------------------------ server
API_PORT=4000

# Comma-separated list of the exact origins allowed to call the API.
# Must be HTTPS in production, and cannot be "*".
CLIENT_ORIGIN="http://localhost:5199"

# Redirect HTTP to HTTPS. Enable when running behind a terminating proxy.
FORCE_HTTPS=false

# Background jobs: reminders, expired table holds, no-show close-out.
# Set to false on every instance but one when running more than one.
RUN_SCHEDULER=true

# ---------------------------------------------------------------- security
# Failed sign-ins before an account locks, and for how long.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Lists working demo credentials on the sign-in screen. Ignored in production.
SHOW_DEMO_ACCOUNTS=true

# -------------------------------------------------------------------- mail
# Leave SMTP_HOST empty to log messages instead of delivering them.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Asian Wok <reservations@asianwok.pk>"
